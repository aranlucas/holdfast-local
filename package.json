{
  "name": "holdfast",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "portless run vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4319 --strictPort",
    "start": "node server.mjs",
    "test": "pnpm run typecheck:tooling && vitest run",
    "test:e2e": "playwright test",
    "format": "oxfmt --write",
    "check:format": "oxfmt --check",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix",
    "format:check": "oxfmt --check",
    "typecheck:tooling": "tsc --noEmit -p tsconfig.tooling.json"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "jszip": "^3.10.2",
    "lucide-react": "^1.61.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@aranlucas/oxforge": "^0.2.2",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "husky": "^9.1.7",
    "ical.js": "^2.2.1",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "portless": "0.15.8",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,json5,css,scss,md,mdx,yml,yaml,html,toml,vue,svelte,astro,graphql}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@12.14.0"
}
