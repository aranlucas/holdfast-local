{
  "name": "holdfast",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "portless run vite",
    "build": "tsc -b && vite build && node scripts-build-sw.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4319 --strictPort",
    "start": "node server.mjs",
    "test": "npm run typecheck:tooling && vitest run",
    "test:e2e": "playwright test",
    "format": "oxfmt --write",
    "check:format": "oxfmt --check",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix",
    "format:check": "oxfmt --check",
    "typecheck:tooling": "tsc --noEmit -p tsconfig.tooling.json"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "pdfjs-dist": "^5.4.624",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@aranlucas/oxforge": "^0.2.2",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "24.19.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "husky": "^9.1.7",
    "ical.js": "^2.2.1",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "portless": "0.15.7",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,json5,css,scss,md,mdx,yml,yaml,html,toml,vue,svelte,astro,graphql}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  }
}
