{
  "name": "holdfast",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless run vite",
    "build": "tsc -b && vite build && node scripts-build-sw.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4319 --strictPort",
    "start": "node server.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.json *.ts *.mjs",
    "check:format": "prettier --check src tests *.json *.ts *.mjs",
    "lint": "oxlint .",
    "lint:plugin": "node tools/oxlint/verify-anti-slop.mjs",
    "lint:fix": "oxlint --fix",
    "format:check": "oxfmt --check",
    "format:oxforge": "oxfmt --write"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "pdfjs-dist": "^5.4.624",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@aranlucas/oxforge": "^0.1.3",
    "@aranlucas/oxlint-plugin-anti-slop": "0.1.0",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.58.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "ical.js": "^2.2.1",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "portless": "0.15.7",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
