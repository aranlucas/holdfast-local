{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./node_modules/@aranlucas/oxforge/configs/recommended.json",
    "./node_modules/@aranlucas/oxforge/configs/react.json",
    "./node_modules/@aranlucas/oxforge/configs/vitest.json"
  ],
  "ignorePatterns": [
    "node_modules/**",
    "build/**",
    "dist/**",
    "coverage/**",
    ".snapshot*",
    ".next/**",
    "_site/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.next/**",
    "**/.expo/**",
    "**/.vercel/**",
    "**/.agent/**",
    "**/.agents/**",
    "**/.claude/**",
    "**/.codex/**",
    "**/.continue/**",
    "**/.cursor/**",
    "**/.gemini/**",
    "**/.opencode/**",
    "**/.pi/**",
    "**/.roo/**",
    "**/.windsurf/**"
  ],
  "options": {
    "typeAware": true
  },
  "overrides": [
    {
      "files": ["test/e2e/**/*.e2e.ts", "test/helpers/external-requests.ts"],
      "rules": {
        "eslint/complexity": [
          "error",
          {
            "max": 9,
            "variant": "classic"
          }
        ]
      }
    }
  ]
}
